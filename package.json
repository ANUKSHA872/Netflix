{
  "name": "streamnest",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd frontend && npm install",
    "build": "cd frontend && npm install && npm run build",
    "deploy": "cd frontend && npm run build:gh && cd .. && npx gh-pages -d dist",
    "deploy:api": "node scripts/deploy-gh.js",
    "start": "cd backend && node server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
